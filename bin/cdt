#!/bin/bash
# chrome-devtools CLI bound to a rainbow Chrome (see chromeR..chromeV in shell.rc).
# One daemon per Chrome, session ID = debugging port (+ hex host if remote). Ensures the daemon is up and
# attached to the right port before each call, so a dead daemon never falls back
# to launching a default headless Chrome. `@host` targets another machine's rainbow
# Chrome (its port forwarded tailnet-only; use the Tailscale IP, Chrome rejects names).
# usage: cdt <R|O|Y|G|B|I|V>[@host] <command> [args...]   e.g. cdt R list_pages, cdt B stop,
#        cdt R@100.108.104.88 list_pages
host=127.0.0.1
[[ $1 == *@* ]] && host=${1#*@}
case ${1%@*} in
    R) port=9223 ;; O) port=9224 ;; Y) port=9225 ;; G) port=9226 ;;
    B) port=9227 ;; I) port=9228 ;; V) port=9229 ;;
    *) echo "usage: cdt <R|O|Y|G|B|I|V>[@host] <command> [args...]" >&2; exit 2 ;;
esac
shift
export CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1 CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS=1
sid=$port
[[ $host == 127.0.0.1 ]] || sid="$port-$(printf %s "$host" | xxd -p | tr -d '\n')"  # sessionId allows only [0-9a-f-]
cd=(chrome-devtools --sessionId "$sid")
[[ $1 == stop ]] && exec "${cd[@]}" stop
"${cd[@]}" status 2>/dev/null | grep -q "browser-url=http://$host:$port\"" ||
    "${cd[@]}" start --browserUrl "http://$host:$port" --usageStatistics=false >/dev/null 2>&1 ||
    { echo "cdt: failed to start daemon for $host:$port" >&2; exit 1; }
exec "${cd[@]}" "$@"
